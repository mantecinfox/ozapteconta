# ─────────────────────────────────────────────────────────────────────────────
#  FinanceBot — Variaveis de Ambiente do Backend
#  Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Banco de Dados PostgreSQL
# Hostinger/App Node.js:
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO

# Seguranca
JWT_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA

# URLs
FRONTEND_URL=http://localhost:3000

# Armazenamento de Audios
AUDIO_STORAGE_PATH=./storage/audios
REPORTS_STORAGE_PATH=./storage/reports
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# WhatsApp Cloud API (configure no Dashboard apos instalacao)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=financebot_verify
WHATSAPP_WEBHOOK_SECRET=

# Provedores de IA (configure no Dashboard)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
ABACUS_API_KEY=
ABACUS_API_URL=https://routellm.abacus.ai
OLLAMA_BASE_URL=http://localhost:11434

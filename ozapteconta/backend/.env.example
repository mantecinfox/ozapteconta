# ─────────────────────────────────────────────────────────────────────────────
#  FinanceBot — Variaveis de Ambiente do Backend
#  Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Banco de Dados PostgreSQL
# Hostinger/App Node.js:
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO

# Seguranca
JWT_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA

# URLs
FRONTEND_URL=http://localhost:3000

# Armazenamento de Audios
AUDIO_STORAGE_PATH=./storage/audios
REPORTS_STORAGE_PATH=./storage/reports
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# WhatsApp Cloud API (configure no Dashboard apos instalacao)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=financebot_verify
WHATSAPP_WEBHOOK_SECRET=

# Provedores de IA (configure no Dashboard)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
ABACUS_API_KEY=
ABACUS_API_URL=https://routellm.abacus.ai
OLLAMA_BASE_URL=http://localhost:11434

# InfinitePay Checkout (links PIX/cartão/boleto)
# Obrigatório: Merchant Key com prefixo $
# Opcional: API Key (só se sua conta InfinitePay exigir Bearer)
INFINITYPAY_MERCHANT_KEY=$mantecinfoxsystem
INFINITYPAY_API_KEY=
INFINITYPAY_API_URL=https://api.checkout.infinitepay.io

# Redis (filas e workers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Apify — busca de voos (Plano Travel)
APIFY_API_TOKEN=
APIFY_FLIGHT_ACTOR_ID=johnvc/google-flights-data-scraper-flight-and-price-search
APIFY_REQUEST_TIMEOUT_MS=30000
APIFY_RUN_TIMEOUT_MS=120000
APIFY_FLIGHT_MAX_RESULTS=20

# Copie estes valores para as variaveis de ambiente do App Node.js na Hostinger.
# Nao envie este arquivo preenchido com segredos para o repositorio.

NODE_ENV=production
PORT=3001

# PostgreSQL criado pela Hostinger ou servico gerenciado.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO

# Use uma string aleatoria longa, com pelo menos 32 caracteres.
JWT_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA_E_SEGURA
JWT_EXPIRES_IN=7d

# Dominio publico final com HTTPS.
FRONTEND_URL=https://seudominio.com.br

# Caminhos persistentes do App Node.js, ajuste conforme o painel da Hostinger.
AUDIO_STORAGE_PATH=./storage/audios
REPORTS_STORAGE_PATH=./storage/reports
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Execute o seed somente no primeiro deploy quando quiser criar dados iniciais.
RUN_PRISMA_SEED=false

# WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=financebot_verify
WHATSAPP_WEBHOOK_SECRET=

# Provedores de IA.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=

# E-mail SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Dados de mercado, se usados.
BRAPI_TOKEN=
ALPHA_VANTAGE_KEY=
